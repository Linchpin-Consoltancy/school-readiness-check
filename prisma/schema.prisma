// Linchpin School Systems Self-Assessment
// Local development uses SQLite. Production uses Postgres (Neon).
// Only portable column types are used here so the provider swap is a one-line change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// One principal's assessment session. The id doubles as the private
/// resume link token, so it is generated with cryptographic randomness.
model Assessment {
  id String @id

  // Captured at the end of the assessment, once the director has invested
  // the time and has a reason to hand over their details.
  fullName   String
  email      String
  /// Defaulted so the column could be added without disturbing existing rows.
  /// New assessments always supply it; the form requires it.
  phone      String  @default("")
  schoolName String
  schoolType String
  enrolment  String
  region     String?

  // Lifecycle. Stored as a string rather than an enum so that SQLite and
  // Postgres behave identically.
  status      String    @default("in_progress")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  responses    Response[]
  domainScores DomainScore[]

  @@index([email])
  @@index([createdAt])
}

/// A single answer. Questions are addressed by the code used in the content
/// file, such as A1.1 (lens A, domain 1, question 1).
///
/// Both fields are optional because a row is created the moment a principal
/// touches a question. Someone may type a note before choosing a rating, and
/// a rating of nothing must be distinguishable from a rating of one.
model Response {
  id           String  @id @default(cuid())
  assessmentId String
  questionId   String
  rating       Int?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

/// A calculated result for one domain, written whenever an answer changes.
///
/// Scores are stored at full precision. The one decimal place figure the
/// principal sees is produced at display time, so the stored numbers can
/// never disagree with a recalculation.
model DomainScore {
  id           String @id @default(cuid())
  assessmentId String
  domainId     String

  lensAScore Float
  lensBScore Float
  lensCScore Float

  /// Full precision, for example 2.1666666666666665.
  score Float

  /// Tier id: critical, high, moderate or sustain.
  tier String

  gapFlag Boolean @default(false)

  /// Lens letters that triggered the gap, comma separated, for example "A,C".
  /// Stored as text because SQLite has no array type and the value is short.
  gapLenses String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domainId])
  @@index([assessmentId])
}
