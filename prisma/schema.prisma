// Linchpin School Readiness Check
//
// Postgres, hosted on Neon. Development and production run the same kind of
// database, so what works on a laptop works when deployed. Neon gives every
// project a separate development branch for exactly that purpose.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One school's completed check. The id doubles as the private link to that
/// school's report, so it is generated with cryptographic randomness rather
/// than a guessable counter.
model Assessment {
  id String @id

  // Captured at the end, once the director has done the work and has a
  // reason to hand over their details.
  fullName   String
  email      String
  phone      String
  schoolName String
  schoolType String
  enrolment  String
  region     String?

  // Lifecycle. A plain string rather than a database enum, so adding a state
  // later is a code change rather than a migration.
  status      String    @default("in_progress")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  responses    Response[]
  domainScores DomainScore[]

  @@index([email])
  @@index([createdAt])
}

/// A single answer. Questions are addressed by the code in the content file,
/// such as D01-A, meaning area one seen through the Design view.
model Response {
  id           String @id @default(cuid())
  assessmentId String
  questionId   String
  rating       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
}

/// A calculated result for one area, written whenever an answer changes.
///
/// Scores are stored at full precision. The one decimal place figure the
/// director sees is produced at display time, so the stored numbers can never
/// disagree with a recalculation.
model DomainScore {
  id           String @id @default(cuid())
  assessmentId String
  domainId     String

  lensAScore Float
  lensBScore Float
  lensCScore Float

  /// Full precision, for example 1.3333333333333333.
  score Float

  /// Tier id: critical, high, moderate or sustain.
  tier String

  gapFlag Boolean @default(false)

  /// Which views triggered the gap, comma separated, for example "A,C".
  /// Text rather than an array: the value is short, and it keeps the
  /// spreadsheet export readable without unpacking.
  gapLenses String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, domainId])
  @@index([assessmentId])
}
